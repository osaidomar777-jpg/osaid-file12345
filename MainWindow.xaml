<Window x:Class="OsaidFileFetcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Osaid File | إدارة ونقل الملفات"
        Icon="pack://application:,,,/Resources/OsaidFile.ico"
        Height="820"
        Width="1340"
        MinHeight="720"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFilesCommand}"/>
        <KeyBinding Key="F5" Command="{Binding CheckDeviceConnectionCommand}"/>
    </Window.InputBindings>

    <Border x:Name="RootFrame" Background="{StaticResource AppBackgroundGradient}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <!-- توهّجات خلفية خفيفة تعطي عمق النموذج الأولي دون أي تكلفة على الأداء -->
            <Rectangle Grid.Row="0" Grid.RowSpan="4" Fill="{StaticResource AppGridPatternBrush}" IsHitTestVisible="False"/>
            <Rectangle Grid.Row="0" Grid.RowSpan="4" Fill="{StaticResource AppAuroraTopBrush}" IsHitTestVisible="False"/>
            <Rectangle Grid.Row="0" Grid.RowSpan="4" Fill="{StaticResource AppAuroraBottomBrush}" IsHitTestVisible="False"/>

            <Ellipse Grid.Row="0" Grid.RowSpan="4" Width="620" Height="520"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-260,-180,0" IsHitTestVisible="False"
                     Fill="{StaticResource GlowCyanBrush}"/>
            <Ellipse Grid.Row="0" Grid.RowSpan="4" Width="680" Height="560"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-220,0,0,-240" IsHitTestVisible="False"
                     Fill="{StaticResource GlowBlueBrush}"/>

            <!-- شريط العنوان المخصص (العنوان المطلوب ظاهر هنا) -->
            <Grid Grid.Row="0" Background="#FF070D17" FlowDirection="LeftToRight">
                <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <Grid Margin="12,0,8,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="/Resources/OsaidFile.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="Osaid File | إدارة ونقل الملفات"
                                   Margin="10,0,0,0"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" ToolTip="تصغير">
                            <TextBlock Text="&#xE921;" Style="{StaticResource IconGlyphStyle}" FontSize="10"/>
                        </Button>

                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" ToolTip="تكبير">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconGlyphStyle}" FontSize="10"/>
                        </Button>

                        <Button Style="{StaticResource CloseWindowButtonStyle}" Click="Close_Click" ToolTip="إغلاق">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyphStyle}" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- شريط الوحدات العلوي المستعاد من المشروع الأول -->
            <Border Grid.Row="1" Background="#FF091221"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid FlowDirection="LeftToRight" Margin="8,0,252,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                FlowDirection="RightToLeft">
                        <Button x:Name="TopDeviceButton"
                                AutomationProperties.AutomationId="TopDeviceButton"
                                AutomationProperties.Name="الجهاز"
                                Style="{StaticResource ModuleTabButtonStyle}" Click="TopModule_Click" Tag="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="20"/>
                                <TextBlock Text="الجهاز" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TopAppsButton"
                                AutomationProperties.AutomationId="TopAppsButton"
                                AutomationProperties.Name="التطبيقات"
                                Style="{StaticResource ModuleTabButtonStyle}" Click="TopModule_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="20"/>
                                <TextBlock Text="التطبيقات" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TopRingtonesButton"
                                AutomationProperties.AutomationId="TopRingtonesButton"
                                AutomationProperties.Name="النغمات والخلفيات"
                                Style="{StaticResource ModuleTabButtonStyle}" Click="TopModule_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="20"/>
                                <TextBlock Text="النغمات والخلفيات" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TopFlashButton"
                                AutomationProperties.AutomationId="TopFlashButton"
                                AutomationProperties.Name="الفلاش الذكي"
                                Style="{StaticResource ModuleTabButtonStyle}" Click="TopModule_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B4;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="20"/>
                                <TextBlock Text="الفلاش الذكي" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TopToolboxButton"
                                AutomationProperties.AutomationId="TopToolboxButton"
                                AutomationProperties.Name="صندوق الأدوات"
                                Style="{StaticResource ModuleTabButtonStyle}" Click="TopModule_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90C;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="20"/>
                                <TextBlock Text="صندوق الأدوات" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource ChipStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0" ToolTip="{Binding IphoneSupportText}">
                        <TextBlock Text="{Binding IphoneChipText}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentLightBrush}" MaxWidth="230"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- جسم التطبيق: القائمة الجانبية الكاملة + المحتوى -->
            <Grid Grid.Row="2" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="252"/>
                </Grid.ColumnDefinitions>

                <!-- القائمة الجانبية -->
                <Border Grid.Column="1"
                        Background="{StaticResource SidebarGradientBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- الهوية وزر الإضافة الموحّد -->
                        <StackPanel Grid.Row="0" Margin="18,14,18,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="12"
                                        BorderBrush="#36FFFFFF" BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/Resources/OsaidFile.png" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="Osaid File"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="إدارة ونقل الملفات"
                                               FontSize="9.5"
                                               Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    x:Name="AddFilesTopButton"
                                    AutomationProperties.AutomationId="AddFilesTopButton"
                                    AutomationProperties.Name="إضافة ملفات"
                                    Margin="0,10,0,0"
                                    Height="40"
                                    Click="AddFiles_Click"
                                    ToolTip="إضافة ملفات (Ctrl+O)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyphStyle}" FontSize="13"/>
                                    <TextBlock Text="إضافة ملفات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- التنقل الكامل: كل أقسام المشروع الأول -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,2,12,0">
                                <Button x:Name="HomeButton"
                                        AutomationProperties.AutomationId="HomeButton"
                                        AutomationProperties.Name="لوحة التحكم"
                                        Style="{StaticResource NavButtonStyle}" Click="Home_Click"
                                        ToolTip="لوحة التحكم">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                        <TextBlock Text="لوحة التحكم" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SidebarDownloaderButton"
                                        AutomationProperties.AutomationId="SidebarDownloaderButton"
                                        AutomationProperties.Name="التنزيل الخاص بأسيد"
                                        Style="{StaticResource NavButtonStyle}" Click="SidebarDownloader_Click"
                                        ToolTip="تنزيل الفيديو والصوت من المواقع المدعومة">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                        <TextBlock Text="التنزيل الخاص بأسيد" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Expander Header="الأجهزة" IsExpanded="True"
                                          AutomationProperties.AutomationId="DevicesGroup"
                                          Foreground="{StaticResource PrimaryTextBrush}"
                                          Background="Transparent"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          FontSize="11.5" FontWeight="Bold">
                                    <StackPanel Margin="0,4,0,6">
                                        <Button x:Name="SidebarDeviceInfoButton"
                                                AutomationProperties.AutomationId="SidebarDeviceInfoButton"
                                                AutomationProperties.Name="معلومات الجهاز"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarDeviceInfo_Click"
                                                ToolTip="المواصفات والبطارية والمساحة">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="معلومات الجهاز" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarAppsButton"
                                                AutomationProperties.AutomationId="SidebarAppsButton"
                                                AutomationProperties.Name="التطبيقات"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarApps_Click"
                                                ToolTip="تطبيقات الآيفون الموصول">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE71D;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="التطبيقات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource ChipStyle}" Margin="8,0,0,0" Padding="7,1"
                                                        Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding AppsCountText}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentLightBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarPhotosButton"
                                                AutomationProperties.AutomationId="SidebarPhotosButton"
                                                AutomationProperties.Name="الصور"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarPhotos_Click"
                                                ToolTip="الألبومات والصور">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEB9F;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="الصور" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarMusicButton"
                                                AutomationProperties.AutomationId="SidebarMusicButton"
                                                AutomationProperties.Name="الموسيقى"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarMusic_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="الموسيقى" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarRingtonesButton"
                                                AutomationProperties.AutomationId="SidebarRingtonesButton"
                                                AutomationProperties.Name="النغمات"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarRingtones_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="النغمات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarVideosButton"
                                                AutomationProperties.AutomationId="SidebarVideosButton"
                                                AutomationProperties.Name="الفيديوهات"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarVideos_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE714;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="الفيديوهات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarBooksButton"
                                                AutomationProperties.AutomationId="SidebarBooksButton"
                                                AutomationProperties.Name="الكتب"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarBooks_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A5;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="الكتب" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarUDiskButton"
                                                AutomationProperties.AutomationId="SidebarUDiskButton"
                                                AutomationProperties.Name="قرص UDisk"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarUDisk_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="قرص UDisk" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarDataButton"
                                                AutomationProperties.AutomationId="SidebarDataButton"
                                                AutomationProperties.Name="البيانات"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarData_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE937;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="البيانات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarFilesButton"
                                                AutomationProperties.AutomationId="SidebarFilesButton"
                                                AutomationProperties.Name="الملفات"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarFiles_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="الملفات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarCommonToolsButton"
                                                AutomationProperties.AutomationId="SidebarCommonToolsButton"
                                                AutomationProperties.Name="أدوات شائعة"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarCommonTools_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE90C;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="أدوات شائعة" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarTextButton"
                                                AutomationProperties.AutomationId="SidebarTextButton"
                                                AutomationProperties.Name="النصوص والحافظة"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarText_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8E3;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="النصوص والحافظة" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarHistoryButton"
                                                AutomationProperties.AutomationId="SidebarHistoryButton"
                                                AutomationProperties.Name="سجل النقل"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarHistory_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE81C;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="سجل النقل" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SidebarSettingsButton"
                                                AutomationProperties.AutomationId="SidebarSettingsButton"
                                                AutomationProperties.Name="الإعدادات والتشخيص"
                                                Style="{StaticResource NavButtonStyle}" Click="SidebarSettings_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Width="20"/>
                                                <TextBlock Text="الإعدادات والتشخيص" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- بطاقة حالة الاتصال (معلومات فقط، ليست تنقلاً) -->
                        <Border Grid.Row="2"
                                Margin="14,0,14,10"
                                Padding="12,9"
                                CornerRadius="12"
                                Background="#08FFFFFF"
                                BorderBrush="#12FFFFFF"
                                BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="{x:Type Ellipse}">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        <Setter Property="Effect" Value="{StaticResource SuccessGlowShadow}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock Text="الاتصال محلي"
                                               Margin="7,0,0,0"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding ConnectionStatus}"
                                           Margin="0,5,0,0"
                                           FontSize="9.5"
                                           LineHeight="14"
                                           MaxHeight="28"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock Text="بدون إنترنت · عبر كابل USB"
                                           Margin="0,3,0,0"
                                           FontSize="9"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- المنطقة الرئيسية -->
                <Grid Grid.Column="0" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="26,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderTitle" AutomationProperties.AutomationId="HeaderTitle"
                                           Text="لوحة التحكم"
                                           FontSize="14.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="HeaderSubtitle"
                                           Text="نظرة سريعة على الجهاز المتصل ونقل الملفات"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border Style="{StaticResource ChipStyle}" Margin="0,0,10,0"
                                        ToolTip="{Binding DevicesSummaryText}">
                                    <TextBlock Text="{Binding DevicesSummaryText}" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource AccentLightBrush}"/>
                                </Border>

                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding CheckDeviceConnectionCommand}"
                                        ToolTip="إعادة فحص الأجهزة المتصلة (F5)">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyphStyle}" FontSize="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ClipToBounds="True">
                        <ContentControl x:Name="MainContent"
                                        AutomationProperties.AutomationId="MainContent"
                                        Background="Transparent"
                                        Focusable="False"
                                        ClipToBounds="True"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>

                        <!-- إشعار عائم (Toast) -->
                        <Border x:Name="ToastHost"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,26"
                                MaxWidth="560"
                                Padding="16,12"
                                CornerRadius="12"
                                Background="#FF101C2C"
                                BorderThickness="1"
                                BorderBrush="{Binding ToastAccent}"
                                IsHitTestVisible="False"
                                Panel.ZIndex="10"
                                Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                            </Border.Effect>

                            <Border.RenderTransform>
                                <TranslateTransform Y="14"/>
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         To="0"
                                                                         Duration="0:0:0.24">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.16"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ToastGlyph}"
                                           Style="{StaticResource IconGlyphStyle}"
                                           FontSize="15"
                                           Foreground="{Binding ToastAccent}"/>

                                <TextBlock Text="{Binding ToastMessage}"
                                           Margin="10,0,0,0"
                                           FontSize="12.5"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- شريط الإجراءات السريعة المستعاد من المشروع الأول -->
            <Border Grid.Row="3" Background="#FF070D17"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid FlowDirection="RightToLeft" Margin="8,0,252,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="إجراءات سريعة" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" VerticalAlignment="Center"/>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="QuickBackupButton"
                                    AutomationProperties.AutomationId="QuickBackupButton"
                                    AutomationProperties.Name="النسخ الاحتياطي / الاستعادة"
                                    Style="{StaticResource QuickActionButtonStyle}" Click="QuickAction_Click"
                                    Width="192" ToolTip="النسخ الاحتياطي / الاستعادة">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C4;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="18"/>
                                    <TextBlock Text="النسخ الاحتياطي / الاستعادة" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuickAirplayButton"
                                    AutomationProperties.AutomationId="QuickAirplayButton"
                                    AutomationProperties.Name="العرض اللاسلكي"
                                    Style="{StaticResource QuickActionButtonStyle}" Click="QuickAction_Click"
                                    Width="140" ToolTip="العرض اللاسلكي">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D2;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="18"/>
                                    <TextBlock Text="العرض اللاسلكي" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuickMakeRingtoneButton"
                                    AutomationProperties.AutomationId="QuickMakeRingtoneButton"
                                    AutomationProperties.Name="إنشاء نغمة"
                                    Style="{StaticResource QuickActionButtonStyle}" Click="QuickAction_Click"
                                    Width="128" ToolTip="إنشاء نغمة">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="18"/>
                                    <TextBlock Text="إنشاء نغمة" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuickIconsButton"
                                    AutomationProperties.AutomationId="QuickIconsButton"
                                    AutomationProperties.Name="إدارة الأيقونات"
                                    Style="{StaticResource QuickActionButtonStyle}" Click="QuickAction_Click"
                                    Width="140" ToolTip="إدارة الأيقونات">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80D;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="18"/>
                                    <TextBlock Text="إدارة الأيقونات" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuickStopUpdateButton"
                                    AutomationProperties.AutomationId="QuickStopUpdateButton"
                                    AutomationProperties.Name="إيقاف تحديث iOS"
                                    Style="{StaticResource QuickActionButtonStyle}" Click="QuickAction_Click"
                                    Width="150" ToolTip="إيقاف تحديث iOS">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="18"/>
                                    <TextBlock Text="إيقاف تحديث iOS" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuickTransferButton"
                                    AutomationProperties.AutomationId="QuickTransferButton"
                                    AutomationProperties.Name="نقل البيانات"
                                    Style="{StaticResource QuickActionButtonStyle}" Click="QuickAction_Click"
                                    Width="124" ToolTip="نقل البيانات">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="18"/>
                                    <TextBlock Text="نقل البيانات" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuickCustomizeButton"
                                    AutomationProperties.AutomationId="QuickCustomizeButton"
                                    AutomationProperties.Name="تخصيص"
                                    Style="{StaticResource QuickActionButtonStyle}" Click="QuickAction_Click"
                                    Width="110" ToolTip="تخصيص">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE771;" Style="{StaticResource IconGlyphStyle}" FontSize="13" Width="18"/>
                                    <TextBlock Text="تخصيص" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
